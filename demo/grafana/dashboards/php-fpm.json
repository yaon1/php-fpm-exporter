{
  "title": "PHP-FPM & OPcache",
  "uid": "php-fpm-exporter",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(phpfpm_up, pool)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pools up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(phpfpm_up{pool=~\"$pool\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(phpfpm_accepted_connections_total{pool=~\"$pool\"}[1m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "OPcache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(opcache_hits_total{pool=~\"$pool\"}[5m])) / (sum(rate(opcache_hits_total{pool=~\"$pool\"}[5m])) + sum(rate(opcache_misses_total{pool=~\"$pool\"}[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Max children reached (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(phpfpm_max_children_reached_total{pool=~\"$pool\"}[1h]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Workers",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool) (phpfpm_active_processes{pool=~\"$pool\"})",
          "legendFormat": "{{pool}} active"
        },
        {
          "refId": "B",
          "expr": "sum by (pool) (phpfpm_idle_processes{pool=~\"$pool\"})",
          "legendFormat": "{{pool}} idle"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Listen queue",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "phpfpm_listen_queue{pool=~\"$pool\"}",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Longest request",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "phpfpm_process_max_request_duration_seconds{pool=~\"$pool\"}",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Slow requests/min",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(phpfpm_slow_requests_total{pool=~\"$pool\"}[5m]) * 60",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "OPcache memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "opcache_memory_bytes{pool=~\"$pool\"}",
          "legendFormat": "{{pool}} {{kind}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "OPcache restarts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(opcache_restarts_total{pool=~\"$pool\"}[5m])",
          "legendFormat": "{{pool}} {{reason}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Peak request CPU & memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "phpfpm_process_max_last_request_cpu_ratio{pool=~\"$pool\"}",
          "legendFormat": "{{pool}} cpu"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Running request age",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "phpfpm_process_avg_running_request_duration_seconds{pool=~\"$pool\"}",
          "legendFormat": "{{pool}} avg"
        },
        {
          "refId": "B",
          "expr": "phpfpm_process_max_request_duration_seconds{pool=~\"$pool\"}",
          "legendFormat": "{{pool}} max"
        }
      ]
    }
  ]
}