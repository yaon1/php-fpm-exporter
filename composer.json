{
    "name": "yaon1/php-fpm-exporter",
    "description": "Prometheus exporter for PHP-FPM pool status and OPcache",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Yaon\\FpmExporter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yaon\\FpmExporter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "bin": [
        "bin/php-fpm-exporter"
    ]
}
